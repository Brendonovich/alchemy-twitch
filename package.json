{
  "name": "@brendonovich/alchemy-twitch",
  "version": "0.0.1",
  "description": "Twitch EventSub resources for Alchemy v2, written with Effect v4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brendonovich/alchemy-twitch.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -b",
    "test": "vitest run",
    "generate": "node scripts/generate-eventsub.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "^2.0.0-beta.84",
    "alchemy": "^2.0.0-beta.84",
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "@cloudflare/workers-types": "5.20261012.1",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@12.2.1"
}
